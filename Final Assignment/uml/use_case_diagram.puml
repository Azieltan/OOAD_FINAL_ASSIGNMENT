@startuml Use Case Diagram
left to right direction
skinparam packageStyle rectangle

actor "Student" as student
actor "Staff" as staff
actor "Final-Year Student" as fy_student

fy_student -up-|> student

rectangle "Smart Equipment Rental & Billing System" {
    usecase "View Equipment Catalog" as UC1
    usecase "Rent Equipment (Checkout)" as UC2
    usecase "Return Equipment" as UC3
    usecase "Calculate Billing Details" as UC4
    usecase "Apply User Discount" as UC5
    usecase "Apply Category-Specific Penalty" as UC6
    usecase "Add Equipment to Catalog" as UC7
}

student --> UC1
student --> UC2
student --> UC3

staff --> UC1
staff --> UC2
staff --> UC3

UC3 .> UC4 : <<include>>
UC4 .> UC5 : <<extend>>
UC4 .> UC6 : <<extend>>

actor "Campus Facilities Manager" as manager
manager --> UC7
manager --> UC1

@enduml
