@startuml Sequence Diagram - Return and Billing Calculation
actor "Renter (Student/Staff)" as client
boundary "RentalAppGUI" as gui
control "RentalSystemFacade" as facade
entity "RentalRecord" as record
entity "Equipment" as equip
control "BillingManager" as billing
entity "Bill" as bill

client -> gui : Click "Process Settle & Return" (recordId, actualDays, isDamaged)
activate gui

gui -> facade : returnEquipment(recordId, actualDays, isDamaged)
activate facade

facade -> record : getUser()
activate record
record --> facade : user
deactivate record

facade -> record : getEquipment()
activate record
record --> facade : equipment (polymorphic)
deactivate record

facade -> record : getPlannedDurationDays()
activate record
record --> facade : plannedDays
deactivate record

facade -> record : getDepositPaid()
activate record
record --> facade : depositPaid
deactivate record

facade -> billing : calculateBill(user, equipment, actualDays, plannedDays, isDamaged, depositPaid)
activate billing

billing -> equip : calculateBaseFee(plannedDays)
activate equip
equip --> billing : baseFee
deactivate equip

note over billing: Determine user discount\n(Staff: 20%, FY Student: 10%)

billing -> equip : calculatePenalty(lateDays, isDamaged)
activate equip
equip --> billing : penaltyAmount (polymorphic)
deactivate equip

create bill
billing -> bill : new Bill(baseFee, discountAmount, penaltyAmount, depositPaid)
activate bill
bill --> billing : bill
deactivate bill

billing --> facade : bill
deactivate billing

facade -> record : setBill(bill)
activate record
deactivate record

facade -> record : setStatus(RETURNED)
activate record
deactivate record

facade -> record : setReturnDate(date)
activate record
deactivate record

alt isDamaged
    facade -> equip : setStatus(DAMAGED)
    activate equip
    deactivate equip
else else
    facade -> equip : setStatus(AVAILABLE)
    activate equip
    deactivate equip
end

facade -> bill : generateDetailedReceipt()
activate bill
bill --> facade : receiptString
deactivate bill

facade --> gui : successMessage + receiptString
deactivate facade

gui -> client : Display settlement receipt (Refund/Pay invoice)
deactivate gui

@enduml
